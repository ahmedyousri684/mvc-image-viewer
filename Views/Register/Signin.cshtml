@using Shoaaa.DAL.Entities
@model User
<h2>Login</h2>
<form class="border border-secondary rounded-1" method="post" asp-action="Home" asp-controller="Authmodel">
    <div class="form-group row ">
        <label for="inputEmail3" class="col-sm-2 col-form-label" asp-for=@Model.Email>Email</label>
        <div class="col-sm-10">
            <input type="email" class="form-control" id="inputEmail3" placeholder="Email" asp-for=@Model.Email>
        </div>
    </div>
    <div class="form-group row">
        <label for="inputPassword3" class="col-sm-2 col-form-label" asp-for=@Model.Password>Password</label>
        <div class="col-sm-10">
            <input type="password" class="form-control" id="inputPassword3" placeholder="Password" asp-for=@Model.Password>
        </div>
    </div>
    
    <div class="form-group row">
        <div class="col-sm-10">
            <button type="submit" class="btn btn-primary">Submit</button>
        </div>
    </div>
</form>
