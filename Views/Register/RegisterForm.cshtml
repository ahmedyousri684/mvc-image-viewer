@using Shoaaa.DAL.Entities
@model User
<h2>Register Now</h2>
<form class="border border-secondary rounded-1" asp-action="Authmodel" asp-controller="Register">
    <div class="form-group row">
        <label for="inputEmail3" class="col-sm-2 col-form-label" asp-for=@Model.Email>Email</label>
        <div class="col-sm-10">
            <input type="email" class="form-control" id="inputEmail3" placeholder="Email" asp-for=@Model.Email>
        </div>
    </div>
    <div class="form-group row">
        <label for="inputPassword3" class="col-sm-2 col-form-label" asp-for=@Model.Password>Password</label>
        <div class="col-sm-10">
            <input type="password" class="form-control" id="inputPassword3" placeholder="Password" asp-for=@Model.Password>
        </div>
    </div>
    <div class="form-group row">
        <label for="inputFirstName" class="col-sm-2 col-form-label" asp-for=@Model.FirstName>First Name</label>
        <div class="col-sm-10">
            <input type="text" class="form-control" id="FirstName" placeholder="First Name" asp-for=@Model.FirstName>
        </div>
    </div>
    <div class="form-group row">
        <label for="inputLastName" class="col-sm-2 col-form-label" asp-for=@Model.LastName>Last Name</label>
        <div class="col-sm-10">
            <input type="text" class="form-control" id="LastName" placeholder="Last Name" asp-for=@Model.LastName>
        </div>
    </div>
    <div class="form-group row">
        <label for="inputMobile" class="col-sm-2 col-form-label" asp-for=@Model.MobileNo>Mobile No.</label>
        <div class="col-sm-10">
            <input type="text" class="form-control" id="Mobileno" placeholder="Mobile No." asp-for=@Model.MobileNo>
        </div>
    </div>
    <fieldset class="form-group">
        <div class="row">
            <legend class="col-form-label col-sm-2 pt-0">Radios</legend>
            <div class="col-sm-10">
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="gridRadios" id="gridRadios1" value="option1" checked>
                    <label class="form-check-label" for="gridRadios1" asp-for=@Model.UserRole>
                        User
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="gridRadios" id="gridRadios2" value="option2">
                    <label class="form-check-label" for="gridRadios2" asp-for=@Model.UserRole>
                        Manager
                    </label>
                </div>
                <div class="form-check disabled">
                    <input class="form-check-input" type="radio" name="gridRadios" id="gridRadios3" value="option3" disabled>
                    <label class="form-check-label" for="gridRadios3">
                        Third disabled radio
                    </label>
                </div>
            </div>
        </div>
    </fieldset>  
    <div class="form-group row">
        <div class="col-sm-10">
            <button type="submit" class="btn btn-primary">Submit</button>
        </div>
    </div>
</form>
